PORT=3000
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Assets ---
# Base URL widget img_url fields are built from (see services/homeService.js).
# Points at the S3 bucket's "assets/" prefix (run scripts/uploadStaticAssets.js
# after adding files to ./assets to publish them there).
ASSETS_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com/assets

# --- AWS S3 ---
# IAM user needs s3:PutObject/s3:GetObject on this bucket. Used for widget
# assets, uploaded child photos, and generated illustrations.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- Resend (email) ---
# From https://resend.com/api-keys. Without this set, emailService no-ops
# (logs and skips) instead of throwing, so the app runs fine without it.
# On the free tier without a verified domain, RESEND_FROM_EMAIL must stay
# on resend.dev and can only deliver to the account's own signup email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OopsyInk <onboarding@resend.dev>

# --- Auth ---
# Origin of the frontend dev server — used for CORS + cookie scoping.
FRONTEND_URL=http://localhost:5173
# Any long random string; used to sign short-lived JWT access tokens.
JWT_ACCESS_SECRET=
# From https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Google sign-in fails
# with a clear error until this is set.
GOOGLE_CLIENT_ID=

# --- Admin panel (kidora-admin) ---
# Single hardcoded operator login for now — no admin-users table yet.
ADMIN_USERNAME=shashank
ADMIN_PASSWORD=shashank
# Origin of the kidora-admin Vite dev server, added to the CORS allowlist.
ADMIN_URL=http://localhost:5174

# --- Google Analytics 4 (server-side purchase confirmation) ---
# From Google Analytics > Admin > Data Streams > (your web stream) >
# Measurement ID / Measurement Protocol API secrets. Used to send a
# redundant server-confirmed "purchase" event (see services/analyticsService.js)
# that isn't affected by ad blockers stripping the client-side gtag.js one.
# Leave blank to skip server-side purchase tracking.
GA_MEASUREMENT_ID=
GA_API_SECRET=
