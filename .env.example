PORT=3000
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Auth ---
# Origin of the frontend dev server — used for CORS + cookie scoping.
FRONTEND_URL=http://localhost:5173
# Any long random string; used to sign short-lived JWT access tokens.
JWT_ACCESS_SECRET=
# From https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Google sign-in fails
# with a clear error until this is set.
GOOGLE_CLIENT_ID=
