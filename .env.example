PORT=3000

# --- Database (required; the server refuses to boot without it) ---
# Supabase -> Project Settings -> Database -> Connection string -> URI,
# on the "Session pooler" tab. NOT the direct db.<ref>.supabase.co host:
# that resolves to IPv6 only, which most hosts (Render's free tier
# included) cannot reach. Two things differ from the direct string —
# the host is aws-0-<region>.pooler.supabase.com, and the username gains
# the project ref: postgres.<project-ref>, not bare postgres. A missing
# project ref fails as an authentication error, which sends you looking
# for a password problem that isn't there.
#
# Port 5432 is the session pooler and is what this app needs. 6543 is the
# transaction pooler, for serverless — it does not hold a session across
# statements, so the SELECT ... FOR UPDATE in db/bookStore.mutateBook
# would lose its lock.
#
# Supabase does not show the database password after project creation.
# If you don't have it, reset it on that same page.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: the project's CA certificate, to verify the TLS host rather
# than just encrypting the connection. See db/database.js.
DATABASE_CA=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Hard ceiling on paid AI calls (character analysis, story generation, each
# illustration attempt) per UTC day, across all users — the backstop for
# the fact that the generation routes are unauthenticated. See
# services/spendGuard.js. Defaults to 200 if unset.
AI_DAILY_GENERATION_CAP=200
# Where to send operator alerts: the one-per-day email when the AI cap
# above is reached, and the orphaned-payment reconciliation alert (see
# services/paymentService.js's notifyReconciliation) whenever the Razorpay
# refund sweep actually refunds or fails to refund something. Sent via the
# same Resend config as everything else in services/emailService.js; leave
# blank to skip alerting entirely (the AI cap and the refund sweep both
# still run either way, just silently).
ALERT_EMAIL=

# --- Assets ---
# Base URL widget img_url fields are built from (see services/homeService.js).
# Points at the S3 bucket's "assets/" prefix (run scripts/uploadStaticAssets.js
# after adding files to ./assets to publish them there).
ASSETS_BASE_URL=https://your-bucket.s3.your-region.amazonaws.com/assets

# --- AWS S3 ---
# IAM user needs s3:PutObject/s3:GetObject on this bucket. Used for widget
# assets, uploaded child photos, and generated illustrations.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- Resend (email) ---
# From https://resend.com/api-keys. Without this set, emailService no-ops
# (logs and skips) instead of throwing, so the app runs fine without it.
# On the free tier without a verified domain, RESEND_FROM_EMAIL must stay
# on resend.dev and can only deliver to the account's own signup email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OopsyInk <onboarding@resend.dev>

# --- Auth ---
# Origin of the frontend dev server — used for CORS + cookie scoping.
FRONTEND_URL=http://localhost:5173
# Any long random string; used to sign short-lived JWT access tokens.
JWT_ACCESS_SECRET=
# From https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Google sign-in fails
# with a clear error until this is set.
GOOGLE_CLIENT_ID=

# --- Admin panel (kidora-admin) ---
# Single operator login for now — no admin-users table yet. Both required;
# the server refuses to boot if either is unset (see
# controllers/adminAuthController.js — this used to silently default to
# "shashank"/"shashank", see BACKLOG.md P0.3).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string, separate from JWT_ACCESS_SECRET — admin and
# customer tokens are different trust domains and shouldn't share a key.
ADMIN_JWT_SECRET=
# Origin of the kidora-admin Vite dev server, added to the CORS allowlist.
ADMIN_URL=http://localhost:5174

# --- Google Analytics 4 (server-side purchase confirmation) ---
# From Google Analytics > Admin > Data Streams > (your web stream) >
# Measurement ID / Measurement Protocol API secrets. Used to send a
# redundant server-confirmed "purchase" event (see services/analyticsService.js)
# that isn't affected by ad blockers stripping the client-side gtag.js one.
# Leave blank to skip server-side purchase tracking.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# --- Razorpay (checkout payments) ---
# From https://dashboard.razorpay.com/app/keys — use the Test Mode keys
# while developing. Until these are set, POST /payments/create-order
# returns a 503 and the frontend's "Pay Now" surfaces a friendly error
# instead of opening the checkout widget.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you create in the Razorpay dashboard (Settings >
# Webhooks) pointed at <your public backend URL>/payments/webhook,
# subscribed to at least the "payment.captured" event. Razorpay only
# shows this secret once, at creation time. Local dev needs a public
# HTTPS URL for Razorpay to reach — use ngrok (or similar) and point the
# webhook at the ngrok URL + /payments/webhook. Leave blank to disable
# webhook verification (POST /payments/webhook will reject with 503) —
# the browser-side /payments/verify call still works fine without it,
# the webhook is only a backstop for the browser dying mid-payment.
RAZORPAY_WEBHOOK_SECRET=
